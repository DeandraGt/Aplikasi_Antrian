# Salin file ini menjadi .env, lalu sesuaikan nilainya.
#   
cp .env.example .env
# File .env TIDAK BOLEH di-commit (lihat .gitignore).
# --- Aplikasi --
NODE_ENV=development
PORT=3000
# Port di sisi HOST (yang diketik di browser / dipakai dari komputer sendiri).
# Bedakan dengan port di dalam container: pemetaannya ada di docker-compose.yml.
# Ubah nilai ini bila port tersebut sudah dipakai aplikasi lain di komputer Anda.
WEB_PORT=5173
SERVER_PORT=3001
DB_HOST_PORT=3307
# --- Database --
# DB_HOST diisi "mysql" karena itu nama service di docker-compose.yml,
# dan Docker menyediakannya sebagai hostname di dalam network.
DB_HOST=mysql
# Port MySQL DI DALAM Docker network — bukan port host. Biarkan 3306.
DB_PORT=3306
DB_NAME=queueapp
DB_USER=queueapp
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-too
# --- Security --
# Dipakai mulai Minggu 13 (authentication). Ganti dengan nilai acak yang panjang.
JWT_SECRET=change-me